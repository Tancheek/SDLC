{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: настроить проект (Ninja)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-G", "Ninja",
                "-DCMAKE_PREFIX_PATH=C:/Qt/6.11.1/mingw_64",
                "-DCMAKE_MAKE_PROGRAM=C:/Qt/Tools/Ninja/ninja.exe",
                "-DCMAKE_C_COMPILER=C:/Qt/Tools/mingw1310_64/bin/gcc.exe",
                "-DCMAKE_CXX_COMPILER=C:/Qt/Tools/mingw1310_64/bin/g++.exe"
            ],
            "options": {
                "env": {
                    "PATH": "C:\\Qt\\Tools\\mingw1310_64\\bin;C:\\Qt\\Tools\\Ninja;C:\\Qt\\6.11.1\\mingw_64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: собрать (Ninja)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build"],
            "options": {
                "env": {
                    "PATH": "C:\\Qt\\Tools\\mingw1310_64\\bin;C:\\Qt\\Tools\\Ninja;C:\\Qt\\6.11.1\\mingw_64\\bin;${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": ["CMake: настроить проект (Ninja)"],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Запустить CurrencyConverter",
            "type": "shell",
            "command": "${workspaceFolder}/build/CurrencyConverter.exe",
            "options": {
                "env": {
                    "PATH": "C:\\Qt\\6.11.1\\mingw_64\\bin;${env:PATH}"
                }
            },
            "dependsOn": ["CMake: собрать (Ninja)"],
            "problemMatcher": []
        }
    ]
}