{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Отладка CurrencyConverter (MinGW / GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/CurrencyConverter.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:\\Qt\\6.11.1\\mingw_64\\bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/Qt/Tools/mingw1310_64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Включить «красивый» вывод контейнеров Qt",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: собрать (Ninja)"
        }
    ]
}